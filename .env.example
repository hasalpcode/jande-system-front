# Copier ce fichier vers `.env` sur le VPS (jamais commiter le `.env` reel)
# et renseigner des vraies valeurs, notamment les secrets.

# Namespace Docker Hub contenant les images buildees par la CI
DOCKERHUB_USERNAME=hasalpcode
IMAGE_TAG=latest

# Base de donnees
DB_NAME=school_management
DB_USERNAME=school_management
DB_PASSWORD=change-me-strong-password

# Securite applicative
JWT_SECRET=change-me-very-long-random-secret
SUPERADMIN_EMAIL=superadmin@school-management.local
SUPERADMIN_PASSWORD=change-me-strong-password

# Origine autorisee pour le frontend (adapter si domaine/IP different)
CORS_ALLOWED_ORIGINS=http://localhost
